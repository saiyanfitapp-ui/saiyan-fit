# Copia in .env.local per lo sviluppo. Su Vercel mettile in Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Solo lato server (mai NEXT_PUBLIC): serve per ricevere i dati da Salute
SUPABASE_SECRET_KEY=sb_secret_xxx
ANTHROPIC_API_KEY=sk-ant-xxx
# Facoltativo: limita l'accesso alla tua email
ALLOWED_EMAIL=
